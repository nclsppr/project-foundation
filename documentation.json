{
  "schemaVersion": 1,
  "renderer": {
    "name": "nimbus",
    "config": "docs-nimbus/astro.config.ts"
  },
  "collections": [
    {
      "id": "public-guides",
      "title": "Public guides",
      "visibility": "public",
      "include": [
        "ADOPTION.md",
        "CHANGELOG.md",
        "DEFAULTS.md",
        "DEFINITION-OF-DONE.md",
        "DOCUMENTATION.md",
        "PRINCIPLES.md",
        "PROJECT-BOOTSTRAP.md",
        "README.md",
        "VERSIONING.md"
      ]
    },
    {
      "id": "governance",
      "title": "Internal governance",
      "visibility": "internal",
      "include": [
        "AGENTS.md",
        "AUDIT.md",
        "CLAUDE.md",
        "DOCUMENTATION-CATALOG.md",
        "PROJECT.md",
        "ROADMAP.md",
        "STATUS.md"
      ]
    },
    {
      "id": "decisions",
      "title": "Decisions",
      "visibility": "reference",
      "include": ["docs/**/*.md"]
    },
    {
      "id": "profiles",
      "title": "Profiles",
      "visibility": "reference",
      "include": ["profiles/**/*.md"]
    },
    {
      "id": "templates",
      "title": "Templates",
      "visibility": "reference",
      "include": ["templates/**/*.md"]
    },
    {
      "id": "examples",
      "title": "Examples",
      "visibility": "reference",
      "include": ["examples/**/*.md"]
    },
    {
      "id": "nimbus-maintenance",
      "title": "Nimbus maintenance",
      "visibility": "reference",
      "include": ["docs-nimbus/AGENT.md"]
    }
  ],
  "ignored": [
    {
      "pattern": "node_modules/**/*.md",
      "reason": "Third-party dependencies"
    },
    {
      "pattern": "dist/**/*.md",
      "reason": "Generated outputs"
    },
    {
      "pattern": "build/**/*.md",
      "reason": "Generated outputs"
    },
    {
      "pattern": ".venv/**/*.md",
      "reason": "Local Python environment"
    },
    {
      "pattern": "docs-nimbus/src/content/docs/**/*.md",
      "reason": "Nimbus collection generated from classified sources"
    },
    {
      "pattern": "docs-nimbus/node_modules/**/*.md",
      "reason": "Third-party Nimbus dependencies"
    },
    {
      "pattern": "docs-nimbus/dist/**/*.md",
      "reason": "Generated Nimbus site"
    }
  ]
}
